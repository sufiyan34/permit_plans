# WorkBridge payment configuration template
# Copy this file to: supabase/functions/.env
# Never commit the real .env file to Git.
# These provider credentials belong ONLY in Supabase Edge Functions (server-side).
# Do not put them in Flutter, Dart files, assets, or app_config.dart.

# -----------------------------------------------------------------------------
# SAFE DEVELOPMENT DEFAULTS
# -----------------------------------------------------------------------------
PAYMENT_MODE=mock
PAYMENT_COLLECTION_PROVIDER=none
PAYMENT_PAYOUT_PROVIDER=none
PLATFORM_COMMISSION_BPS=500
PAYMENT_DEFAULT_CURRENCY=USD

# Supported currencies are a product configuration, NOT a guarantee that a
# provider can collect or pay out in every currency/country.
PAYMENT_DISPLAY_CURRENCIES=USD,EUR,GBP,PKR

# -----------------------------------------------------------------------------
# DLOCAL FOR PLATFORMS
# Leave empty until dLocal gives WorkBridge official sandbox credentials and
# confirms the exact credential names/values for our approved integration.
# Do not guess or generate these values yourself.
# -----------------------------------------------------------------------------
DLOCAL_ENV=sandbox
DLOCAL_API_BASE_URL=
DLOCAL_API_KEY=
DLOCAL_API_SECRET=
DLOCAL_PLATFORM_ACCOUNT_ID=
DLOCAL_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# PAYONEER MARKETPLACE
# Intended as a payout-provider candidate only, subject to its approval and
# written confirmation that the funds flow from the collection provider is
# supported. Confirm exact credentials with Payoneer before filling these.
# -----------------------------------------------------------------------------
PAYONEER_ENV=sandbox
PAYONEER_API_BASE_URL=
PAYONEER_CLIENT_ID=
PAYONEER_CLIENT_SECRET=
PAYONEER_PROGRAM_ID=
PAYONEER_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# FUTURE SAFETY SWITCHES
# Keep live mode disabled until provider onboarding, legal approval, webhook
# verification, refunds, disputes, payouts and reconciliation have been tested.
# -----------------------------------------------------------------------------
PAYMENT_LIVE_ENABLED=false
